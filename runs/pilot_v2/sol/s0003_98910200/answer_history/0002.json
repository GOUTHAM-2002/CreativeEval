        "people/receipts/vendor_invoice_firmware_service.txt (two units)",
        "people/vendor_service_reports/service_report_firmware_visit.md"
      ]
    },
    {
      "claim": "Firmware 3.4 changed temperature words from setpoint-relative to absolute; the unchanged gateway added the setpoint anyway and produced false roughly -40 C values for B and E.",
      "status": "established",
      "confidence": 0.99,
      "evidence": [
        "repo/gateway/rh7_decode.py",
        "people/vendor_service_reports/service_report_firmware_visit.md",
        "deploy/logs/gateway.log",
        "db/ledger.sql"
      ]
    },
    {
      "claim": "At 2026-03-26 00:48Z the room E door opened and the TK05 host link dropped, consistent with the known door-frame cable fault.",
      "status": "established",
      "confidence": 0.98,
      "evidence": [
        "controller/TK05_fault_snapshot.txt seq 3240 DOOR",
        "db/ledger.sql last received seq 3240",
        "people/tickets.json T-0410"
      ]
    },
    {
      "claim": "The excursion was initiated by the open door; TK05 retained cooling capacity, repeatedly ran, tripped four times on high discharge pressure, and then entered protective lockout at about 01:45Z.",
      "status": "established",
      "confidence": 0.98,
      "evidence": [
        "controller/TK05_fault_snapshot.txt",
        "db/ledger.sql",
        "deploy/logs/gateway.log"
      ]
    },
    {
      "claim": "A primary compressor mechanical failure caused the room E excursion.",
      "status": "refuted",
      "confidence": 0.98,
      "evidence": [
        "controller/TK05_fault_snapshot.txt (RUN flags, rising pressure and four TRIP frames before LOCKOUT)",
        "people/recall_notice.txt (site compressor model not recalled)"
      ]
    },
    {
      "claim": "Room E air exceeded -15 C by about 01:15Z and reached at least -8.69 C at 01:40Z; it was 5.19 C when host telemetry resumed at 04:10Z.",
      "status": "established",
      "confidence": 0.97,
      "evidence": [
        "controller/TK05_fault_snapshot.txt",
        "db/ledger.sql TK05 2026-03-26T04:10:12Z raw status"
      ]
    },
    {
      "claim": "The exact maximum room E temperature and exact time-above-threshold cannot be recovered.",
      "status": "undetermined",
      "confidence": 0.99,
      "evidence": [
        "db/ledger.sql sequence gap 3240 to 3293",
        "controller/TK05_fault_snapshot.txt ends at lockout",
        "people/tickets.json T-0410"
      ],
      "alternatives": [
        "The maximum occurred during the untelemetered lockout/link-loss interval and exceeded the 04:10 reading.",
        "The 04:10 reading was near the maximum and recovery had only just begun."
      ]
    },
    {
      "claim": "No useful alert reached operations during the excursion because E warning traffic had been routed to an archived legacy channel and the critical-only override suppressed warnings; the wrong 3.4 decode also hid the true warm value.",
