  "findings": [
    {
      "claim": "Room E was flashed to firmware 3.4 on 2026-03-15 despite the service report saying it was only inspected.",
      "status": "established",
      "confidence": 0.99,
      "evidence": [
        "deploy/logs/gateway.log (TK05 BA,0034 boot at 14:41Z)",
