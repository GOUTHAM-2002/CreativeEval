  "findings": [
    {
      "claim": "VX03 and VX05 were both flashed to firmware 3.4 on 8 June, despite the service report saying VX05 was only inspected.",
      "status": "established",
      "confidence": 0.99,
      "evidence": [
        "controller boot banners 0034 in db/ledger.sql at 2026-06-08T15:02/15:43 gateway time",
        "people/receipts/vendor_invoice_firmware_service.txt (two units)",
        "people/vendor_service_reports/service_report_firmware_visit.md"
      ]
    },
    {
      "claim": "Firmware 3.4 changed air temperature from setpoint-relative to absolute, while the deployed gateway continued adding the setpoint; this made normal C/E temperatures appear near -40 C.",
      "status": "established",
      "confidence": 0.99,
      "evidence": [
        "repo/gateway/rh7_decode.py",
        "people/vendor_service_reports/service_report_firmware_visit.md",
        "db/ledger.sql raw/status words and 0x4000 ABS_TEMP flag",
        "people/probe_checks_sheet.csv"
      ]
    },
    {
      "claim": "Room E suffered a real warm excursion: it crossed approximately -15 C near 2026-06-20T00:50Z, peaked around +7 C, and returned below -15 C near 10:12Z.",
      "status": "established",
      "confidence": 0.97,
      "evidence": [
        "controller/VX05_fault_snapshot.txt",
        "db/ledger.sql raw VX05 frames after link recovery",
        "people/stability_lab_email.md"
      ]
    },
    {
      "claim": "The excursion mechanism was an open room-E door, repeated high-pressure trips, and a 90-minute controller lockout; it was not a failed compressor or drifting setpoint.",
      "status": "established",
      "confidence": 0.97,
      "evidence": [
        "controller/VX05_fault_snapshot.txt (DOOR, four-trip sequence including skipped seq 3556, LOCKOUT)",
        "db/ledger.sql (lockout clear and subsequent RUN cooling)",
        "people/tickets.json T-0402 (open door drops VX05 link)",
        "people/utility_submeter.csv"
      ]
    },
    {
      "claim": "A mechanical VX05 compressor failure was the root cause asserted by the postmortem.",
      "status": "refuted",
      "confidence": 0.97,
      "evidence": [
        "people/postmortem.md",
        "controller/VX05_fault_snapshot.txt",
        "db/ledger.sql raw status frames show pressure trips, lockout clear, compressor RUN and cooling",
        "people/recall_notice.txt excludes installed NK-380 units"
      ]
    },
    {
      "claim": "Maya Mensah most likely propped the room-E door during her night shift, but the surviving records do not directly identify the person at the door.",
      "status": "probable",
      "confidence": 0.82,
