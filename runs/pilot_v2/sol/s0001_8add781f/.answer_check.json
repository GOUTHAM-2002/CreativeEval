      ]
    },
    {
      "claim": "Room E door opened at 2026-03-31T00:56Z true time and was held open long enough to trigger repeated high-pressure trips and a five-trip lockout; cooling later recovered without evidence of compressor failure.",
      "status": "established",
      "confidence": 0.97,
      "evidence": [
