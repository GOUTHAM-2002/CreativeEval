    },
    {
      "claim": "The approximately -40 C dashboard values for A and E were decoder errors, not sensor faults: firmware 3.4 made temperature absolute and set status bit 12, while the deployed decoder continued adding the zone setpoint.",
      "status": "established",
      "confidence": 0.99,
      "evidence": [
        "repo/gateway/rh7_decode.py",
        "db/ledger.sql",
